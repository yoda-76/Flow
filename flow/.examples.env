# Mirrors experiments/.examples.env — set up now for the upcoming
# Breeze/Dhan adapters, even though today's module (rules store, built from
# NSE bhavcopy) needs none of these. Bhavcopy is NSE's public archive, no
# credentials required (confirmed throughout the experiments/ testing).

# Breeze — known-working auth flow, see
# backtest/breeze/data_pipeline/data_fetch_script.md.
# API_SESSION expires daily/at midnight (SEBI requirement, D-49) — a
# "session generation failed" error means it needs regenerating.
API_KEY=""
API_SECRET=""
API_SESSION=""

# Dhan — direct REST API auth (not the MCP tool).
# DHAN_ACCESS_TOKEN: web.dhan.co -> My Profile -> Access DhanHQ APIs ->
# Generate Access Token. Valid 24 hours from generation.
# DHAN_CLIENT_ID: your Dhan client ID, same page.
DHAN_CLIENT_ID=""
DHAN_ACCESS_TOKEN=""
DHAN_POSTBACK_URL=""  # for testing Dhan's webhook/postback functionality
