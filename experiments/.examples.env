# Required by s01_breeze_coverage_check.py (known-working auth flow, see
# backtest/breeze/data_pipeline/data_fetch_script.md for the pattern this
# mirrors).
#
# API_SESSION is a Breeze session token — expires daily / at midnight (SEBI
# requirement, see D-49). If the script fails at "session generation failed",
# regenerate it via the login URL the script prints, then update .env.

API_KEY=""
API_SECRET=""
API_SESSION=""

# Required by s06_cross_provider_check.py — direct Dhan REST API auth (not
# the Dhan MCP tool), since testing the real API path is the point.
#
# DHAN_ACCESS_TOKEN: web.dhan.co -> My Profile -> Access DhanHQ APIs ->
# Generate Access Token. Valid 24 hours from generation — regenerate there
# and update .env when the script reports 401/DH-901 (invalid/expired token).
# DHAN_CLIENT_ID: your Dhan client ID, same page.

DHAN_CLIENT_ID=""
DHAN_ACCESS_TOKEN=""
DHAN_POSTBACK_URL="" # I added a new variable for postback url to test the webhook functionality of dhan api